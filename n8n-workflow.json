      "parameters": {
        "jsCode": "// Use the provided report, or the one generated from web research\nconst inp = $('Normalize Input').first().json;\nlet report = inp.career_report;\nlet source = 'provided';\nif (!report && $('Career Research Report').isExecuted) {\n  report = String($('Career Research Report').first().json.text || '').trim();\n  source = 'web_research';\n}\nreturn [{ json: { ...inp, career_report: report, report_source: source } }];"
      },
