    {
      "parameters": {
        "jsCode": "// Convert the form answers to the same shape the webhook receives\nconst f = $('Student Form').first().json;\nconst pick = (...keys) => {\n  for (const k of keys) {\n    if (f[k] !== undefined && f[k] !== null && String(f[k]).trim() !== '') return String(f[k]).trim();\n  }\n  return '';\n};\n\nlet pdfText = '';\nif ($('Extract CV Text').isExecuted) {\n  pdfText = String($('Extract CV Text').first().json.text || '').trim();\n}\nconst typed = pick('cv_text', 'Or paste your CV text');\n\nreturn [{ json: { body: {\n  name: pick('name', 'Full Name'),\n  email: pick('email', 'Email'),\n  company: pick('company', 'Target Company'),\n  job_role: pick('job_role', 'Target Job Role'),\n  cv_text: pdfText.length >= 50 ? pdfText : typed,\n  career_report: '',\n  source: 'form',\n} } }];"
      },
      "id": "09fdac0f-8ef1-4a02-b7c8-edd668936caa",
      "name": "Form to Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        -32
      ]
    },
    {
      "parameters": {
        "jsCode": "// 1) ترتيب البيانات + التحقق منها\nconst b = $input.first().json.body || {};\nconst d = {\n  name: String(b.name || '').trim(),\n  email: String(b.email || '').trim(),\n  company: String(b.company || '').trim(),\n  job_role: String(b.job_role || '').trim(),\n  cv_text: String(b.cv_text || '').trim().slice(0, 12000),\n  career_report: String(b.career_report || '').trim().slice(0, 12000),\n  source: String(b.source || 'webhook').trim(),\n};\n\nconst errors = [];\nif (!d.company) errors.push('company is required');\nif (!d.job_role) errors.push('job_role is required');\nif (d.cv_text.length < 50) errors.push('cv_text is missing or too short');\nif (d.email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(d.email)) errors.push('email is not valid');\n\nreturn [{ json: { ...d, valid: errors.length === 0, errors } }];"
      },
