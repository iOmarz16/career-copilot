      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst base = d.company + ' ' + d.job_role;\nreturn [\n  { json: { query: base + ' job requirements skills qualifications' } },\n  { json: { query: base + ' interview questions hiring process' } },\n  { json: { query: d.company + ' company overview strategy news' } },\n];"
      },
