    {
      "parameters": {
        "jsCode": "// 3) دمج مخرجات الذكاء الاصطناعي مع بيانات الإدخال\nconst inp = $('Normalize Input').first().json;\nlet ai = $input.first().json.output ?? $input.first().json;\nif (typeof ai === 'string') {\n  ai = JSON.parse(ai.replace(/```json|```/g, '').trim());\n}\n\nconst name = inp.name || ai.candidate_name || 'there';\nconst email = inp.email || ai.candidate_email || '';\n\nreturn [{\n  json: {\n    name,\n    email,\n    company: inp.company || 'the company',\n    job_role: inp.job_role || 'the role',\n    missing_skills: Array.isArray(ai.missing_skills) ? ai.missing_skills : [],\n    learning_plan: Array.isArray(ai.learning_plan) ? ai.learning_plan : [],\n    career_report: $('Attach Report').first().json.career_report || '',\n    report_source: $('Attach Report').first().json.report_source || '',\n  }\n}];"
      },
      "id": "6c2d49e7-a446-4dae-b3c4-d162338eca8b",
      "name": "Merge Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
        -128
      ]
    },
    {
      "parameters": {
        "jsCode": "// 4) بناء إيميل HTML\nconst data = $input.first().json;\nconst esc = s => String(s ?? '')\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst td = 'style=\"border:1px solid #ddd;padding:8px;vertical-align:top\"';\nconst th = 'style=\"border:1px solid #ddd;padding:8px;background:#00704A;color:#fff;text-align:left\"';\n\nconst missingSkills = data.missing_skills\n  .map(s => '<li style=\"margin:4px 0\">' + esc(s) + '</li>')\n  .join('');\n\nconst planRows = data.learning_plan\n  .map((d, i) => '<tr style=\"background:' + (i % 2 ? '#f7f7f7' : '#fff') + '\">'\n    + '<td ' + td + '><strong>Day ' + esc(d.day) + '</strong></td>'\n    + '<td ' + td + '>' + esc(d.skill) + '</td>'\n    + '<td ' + td + '>' + esc(d.activity) + '</td>'\n    + '<td ' + td + '>' + esc(d.resource) + '</td>'\n    + '</tr>')\n  .join('');\n\nconst html = '<div style=\"font-family:Arial,sans-serif;max-width:820px;margin:auto;color:#222;line-height:1.5\">'\n  + '<div style=\"background:#00704A;color:#fff;padding:18px 22px;border-radius:8px 8px 0 0\">'\n  + '<h2 style=\"margin:0\">KFUPM Career Copilot</h2>'\n  + '<div style=\"opacity:.9\">Your Personalized Career Preparation Plan</div>'\n  + '</div>'\n  + '<div style=\"border:1px solid #ddd;border-top:none;padding:18px 22px;border-radius:0 0 8px 8px\">'\n  + '<p>Hi ' + esc(data.name) + ',</p>'\n  + '<p>Based on your CV and the requirements for <strong>' + esc(data.job_role) + '</strong> at '\n  + '<strong>' + esc(data.company) + '</strong>, here is your personalized analysis and learning roadmap.</p>'\n  + '<h3 style=\"color:#00704A\">Skills to Strengthen</h3>'\n  + '<ul>' + missingSkills + '</ul>'\n  + '<h3 style=\"color:#00704A\">Your ' + data.learning_plan.length + '-Day Learning Plan</h3>'\n  + '<table style=\"border-collapse:collapse;width:100%;font-size:14px\">'\n  + '<tr><th ' + th + '>Day</th><th ' + th + '>Skill</th><th ' + th + '>Activity</th><th ' + th + '>Resource</th></tr>'\n  + planRows\n  + '</table>'\n  + (data.career_report\n    ? '<h3 style=\"color:#00704A\">Company &amp; Role Insights</h3>'\n      + '<div style=\"background:#f7f7f7;border-radius:6px;padding:12px 16px;font-size:14px\">'\n      + esc(String(data.career_report).replace(/[#*]/g, '')).split(String.fromCharCode(10)).join('<br>')\n      + '</div>'\n    : '')\n  + '<p style=\"margin-top:24px\">Good luck with your preparation!<br>— KFUPM Career Copilot</p>'\n  + '</div>'\n  + '</div>';\n\nreturn [{\n  json: {\n    name: data.name,\n    email: data.email,\n    company: data.company,\n    job_role: data.job_role,\n    learning_plan: data.learning_plan,\n    email_html: html,\n  }\n}];"
      },
