      "id": "977b16d2-2a25-48f4-b8b9-aa449c75ac66",
      "name": "Web Search",
      "type": "@brave/n8n-nodes-brave-search.braveSearch",
      "typeVersion": 1.1,
      "position": [
        1216,
        112
      ],
      "credentials": {
        "braveSearchApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Collect titles, links and snippets from all search results\nconst found = [];\nconst seen = new Set();\nconst walk = (v) => {\n  if (!v || typeof v !== 'object') return;\n  if (Array.isArray(v)) { v.forEach(walk); return; }\n  if (typeof v.url === 'string' && (v.description || v.title) && !seen.has(v.url)) {\n    seen.add(v.url);\n    const extra = Array.isArray(v.extra_snippets) ? ' ' + v.extra_snippets.join(' ') : '';\n    found.push('- ' + String(v.title || '').replace(/<[^>]+>/g, '') + ' (' + v.url + '): ' + String(v.description || '').replace(/<[^>]+>/g, '') + extra);\n  }\n  Object.values(v).forEach(walk);\n};\n$input.all().forEach(i => walk(i.json));\n\nconst inp = $('Normalize Input').first().json;\nreturn [{ json: {\n  company: inp.company,\n  job_role: inp.job_role,\n  sources_count: found.length,\n  search_context: found.join('\\n').slice(0, 15000) || '(no web results found)',\n} }];"
      },
      "id": "28864f2a-af3c-4aa8-b1a9-c58ef8e98147",
      "name": "Compile Research",
      "type": "n8n-nodes-base.code",
