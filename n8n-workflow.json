      "parameters": {
        "jsCode": "// 5) تجهيز سطر السجل في Google Sheets\nconst d = $('Build Email HTML').first().json;\nconst m = $('Merge Data').first().json;\n\nlet email_sent = false;\nif ($('Send Gmail').isExecuted) {\n  const g = $('Send Gmail').first().json;\n  email_sent = !g.error;\n}\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    name: d.name,\n    email: d.email,\n    company: d.company,\n    job_role: d.job_role,\n    missing_skills_count: m.missing_skills.length,\n    missing_skills: m.missing_skills.join(' | '),\n    plan_days: m.learning_plan.length,\n    email_sent,\n  }\n}];"
